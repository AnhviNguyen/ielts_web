# PostgreSQL (docker-compose: db → pgbouncer → api)
DB_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql+asyncpg://linguaielts:change-this-strong-password@pgbouncer:5432/linguaielts
PGBOUNCER_ENABLED=true

# Application
SECRET_KEY=change-this-64-char-random-string
ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_TABLES=false
FRONTEND_ORIGIN=https://yourdomain.com

# Redis + Celery (required in production)
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
CELERY_ENABLED=true

# Object storage (MinIO in Docker or S3-compatible storage in free PaaS deployment)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-minio-password
S3_BUCKET=linguaielts
S3_PUBLIC_BASE_URL=/media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-password

# Cloudflare R2 example:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<r2-access-key-id>
# S3_SECRET_KEY=<r2-secret-access-key>
# S3_PUBLIC_BASE_URL=https://<public-r2-domain>

# Tigris example:
# S3_ENDPOINT_URL=https://t3.storage.dev
# S3_ACCESS_KEY=<tigris-access-key-id>
# S3_SECRET_KEY=<tigris-secret-access-key>
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://linguaielts.t3.tigrisfiles.io

AUTH_HTTPONLY_REFRESH=true

# Metrics (Prometheus scrapes GET /metrics on api:8000 — set a strong bearer token)
METRICS_ENABLED=true
METRICS_TOKEN=change-this-metrics-bearer-token

# AI
OPENROUTER_API_KEY=sk-or-...

# Observability (optional)
SENTRY_DSN=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_HOURS=24
RESEND_API_KEY=
RESEND_FROM=LinguaIELTS <noreply@yourdomain.com>
BREVO_API_KEY=
BREVO_FROM=LinguaIELTS <noreply@yourdomain.com>
