# PostgreSQL (docker-compose: api → db trực tiếp, không PgBouncer)
DB_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql+asyncpg://linguaielts:change-this-strong-password@db:5432/linguaielts
PGBOUNCER_ENABLED=false

# Application
SECRET_KEY=change-this-64-char-random-string
ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_TABLES=false
FRONTEND_ORIGIN=https://yourdomain.com

# Redis / Celery — tắt cho stack nhẹ (<50 users, ML inline trong API)
REDIS_URL=
REDIS_REQUIRED=false
CELERY_ENABLED=false

# Placement onboarding
PLACEMENT_REQUIRED_AFTER=2026-06-09T00:00:00+07:00

# Lưu file local (volume uploads/) — không cần MinIO cho demo / Fly.io nhỏ
# STORAGE_BACKEND=local
STORAGE_BACKEND=cloudinary
AVATAR_UPLOAD_DIR=uploads/avatars

# Cloudinary — audio/images quiz assets (public_id: audio/{uuid}, images/{uuid})
CLOUDINARY_CLOUD_NAME=dq955rfxi
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nếu sau này dùng S3/Tigris trên Fly, bật lại:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://t3.storage.dev
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=linguaielts
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://linguaielts.t3.tigrisfiles.io

AUTH_HTTPONLY_REFRESH=true
# Set false only for local dev without HTTPS
AUTH_COOKIE_SECURE=true
# Extra trusted SPA origins for CSRF bypass (comma-separated). FRONTEND_ORIGIN is always included.
# CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com

# Metrics (Prometheus scrapes GET /metrics on api:8000 — set a strong bearer token)
METRICS_ENABLED=true
METRICS_TOKEN=change-this-metrics-bearer-token

# AI
OPENROUTER_API_KEY=sk-or-...

# ML — disable Whisper fallback on small Railway workers (1GB). Shadowing still works for videos with YouTube captions.
ML_PRELOAD_ON_STARTUP=false
WHISPER_ENABLED=false

# Observability (optional)
SENTRY_DSN=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_HOURS=24
RESEND_API_KEY=
RESEND_FROM=LinguaIELTS <noreply@yourdomain.com>
BREVO_API_KEY=
BREVO_FROM=LinguaIELTS <noreply@yourdomain.com>

# ── Frontend service (Railway) ───────────────────────────────────────────────
# Nginx proxies /api to the API service over private networking (same-origin cookies).
# Find the internal hostname in Railway → API service → Settings → Networking → Private.
# BACKEND_INTERNAL_URL=http://<api-service-name>.railway.internal:7860
