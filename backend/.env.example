# ── Database ──────────────────────────────────────────────────────────────
# Async driver for FastAPI (required)
DATABASE_URL=postgresql+asyncpg://linguaielts:password@localhost:5432/linguaielts
# Local SQLite demo (optional):
# DATABASE_URL=sqlite+aiosqlite:///./linguaielts.db

# ── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_EMAILS=admin@gmail.com

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=LinguaIELTS API
DEBUG=true
FRONTEND_ORIGIN=http://localhost:5173

# ── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
# Set true in production (default when ENVIRONMENT=production)
REDIS_REQUIRED=false
# Enable when connecting via PgBouncer transaction pool
PGBOUNCER_ENABLED=false

# Object storage — local filesystem by default
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=linguaielts
# S3_PUBLIC_BASE_URL=/media

METRICS_ENABLED=true

# Auth cookies (production: refresh httpOnly; dev set false for simpler testing)
AUTH_HTTPONLY_REFRESH=false

# ── AI ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=google/gemini-2.0-flash-001

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development
# Skip SQLAlchemy create_all on startup when false (production: use Alembic only)
AUTO_CREATE_TABLES=true

# Email (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_HOURS=24
