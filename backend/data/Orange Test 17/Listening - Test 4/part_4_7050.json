              {
                "id": 2838502,
                "level": 2,
                "value": "Hello, everyone.",
                "meta": {
                  "to": 72.855,
                  "from": 71.415,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2838505,
                "level": 2,
                "value": "Today, we're going to look at another natural food product, and that's maple syrup.",
                "meta": {
                  "to": 79.575005,
                  "from": 73.095,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2838520,
                "level": 2,
                "value": "What is this exactly?",
