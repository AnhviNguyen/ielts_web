                  "to": 77.915,
                  "from": 75.115,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2826574,
                "level": 2,
                "value": "We already have three staff members on board, and on top of that, we can transport a further 15 people, that's you, around the coastline.",
                "meta": {
