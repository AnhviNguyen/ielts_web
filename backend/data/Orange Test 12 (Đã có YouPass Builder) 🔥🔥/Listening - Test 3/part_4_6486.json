                  "from": 8.32,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2869025,
                "level": 2,
                "value": "You will hear a lecturer on an environmental studies course discussing how birds are affected by environmental change.",
                "meta": {
                  "to": 19.954998,
                  "from": 11.12,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2869044,
                "level": 2,
                "value": "First, you have some time to look at questions 31 to 40.",
                "meta": {
                  "to": 26.435,
                  "from": 21.795,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2869057,
                "level": 2,
                "value": "Now listen carefully and answer questions 31 to 40.",
                "meta": {
                  "to": 81.71,
                  "from": 76.67,
