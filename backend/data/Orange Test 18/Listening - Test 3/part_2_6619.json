                  "to": 307.345,
                  "from": 304.305,
                  "speaker": "Speaker 2"
                }
              },
              {
                "id": 2840795,
                "level": 2,
                "value": "Conservation is a really important consideration, and you must follow a few basic rules.",
                "meta": {
                  "to": 315.48,
                  "from": 309.0,
                  "speaker": "Speaker 2"
                }
              }
            ]
          },
          {
            "id": 2840810,
            "level": 1,
            "value": "You should never pick all the mushrooms in one area. Collect only enough for your own needs. Be very careful that you don't trample on young mushrooms or other plants. And make sure you don't pick any mushrooms that are endangered and protected by law. There's been a decline in some varieties of wild mushrooms in this part of the country.",
            "children": [
              {
                "id": 2840811,
                "level": 2,
                "value": "You should never pick all the mushrooms in one area.",
                "meta": {
                  "to": 319.56,
