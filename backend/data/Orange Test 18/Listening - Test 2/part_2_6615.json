              {
                "id": 2816656,
                "level": 2,
                "value": "Okay.",
                "meta": {
                  "to": 250.12001,
                  "from": 249.24,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2816658,
                "level": 2,
                "value": "So I'll put a map of the proposed development up on the screen.",
                "meta": {
                  "to": 255.88,
                  "from": 250.36,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2816672,
                "level": 2,
                "value": "You'll see it's bounded on the south side by the main road, which then goes on to Nunston.",
                "meta": {
                  "to": 264.44,
                  "from": 257.72,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2816691,
                "level": 2,
                "value": "Another boundary is formed by London Road on the western side of the development.",
                "meta": {
                  "to": 271.27502,
