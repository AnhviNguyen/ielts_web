                }
              },
              {
                "id": 2816223,
                "level": 2,
                "value": "You will hear a talk to members of the public about plans for a new housing development near a town called Nunston.",
                "meta": {
                  "to": 9.2,
                  "from": 1.5999999,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2816246,
                "level": 2,
