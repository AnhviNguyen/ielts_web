                  "speaker": "Speaker 2"
                }
              }
            ]
          },
          {
            "id": 2799305,
            "level": 1,
            "value": "Yeah. Check it out online. It's always a family friendly event, and there's no entry charge.",
            "children": [
              {
                "id": 2799306,
                "level": 2,
                "value": "Yeah.",
                "meta": {
