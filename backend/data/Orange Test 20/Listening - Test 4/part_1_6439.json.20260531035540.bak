                }
              },
              {
                "id": 2799279,
                "level": 2,
                "value": "Mhmm.",
                "meta": {
                  "to": 343.14502,
                  "from": 342.665,
                  "speaker": "Speaker 2"
                }
              },
              {
                "id": 2799281,
                "level": 2,
                "value": "Well, check and see if it's the same weekend as the Roots Music Festival in Blakewell Gardens.",
                "meta": {
                  "to": 349.065,
                  "from": 343.225,
                  "speaker": "Speaker 2"
                }
              },
              {
                "id": 2799299,
