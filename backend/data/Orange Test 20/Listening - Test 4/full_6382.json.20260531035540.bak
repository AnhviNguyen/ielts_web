          {
            "id": 706,
            "title": "Questions 15-20",
            "description": "<p dir=\"ltr\">Which event in the history of football in the UK took place in each of the following years? Choose the correct answer and move into the gap</p>\n<div dir=\"ltr\" align=\"left\">&nbsp;</div>",
            "part_id": 6487,
            "question_type": "MATCHING_ENDINGS",
            "question_count": 6,
            "content": "<div class=\"note-completion-content\"><p>1870 <span class=\"gap-placeholder\" data-question-id=\"note_comp_15\">______</span></p>\n<p>1874 <span class=\"gap-placeholder\" data-question-id=\"note_comp_16\">______</span></p>\n<p>1875 <span class=\"gap-placeholder\" data-question-id=\"note_comp_17\">______</span></p>\n<p>1877 <span class=\"gap-placeholder\" data-question-id=\"note_comp_18\">______</span></p>\n<p>1878 <span class=\"gap-placeholder\" data-question-id=\"note_comp_19\">______</span></p>\n<p>1880 <span class=\"gap-placeholder\" data-question-id=\"note_comp_20\">______</span></p></div>",
            "option_title": "",
            "options": [
              {
                "text": "the introduction of pay for the players",
                "option": "A"
              },
