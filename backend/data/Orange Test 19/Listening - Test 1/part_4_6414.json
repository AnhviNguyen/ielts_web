                }
              },
              {
                "id": 2800478,
                "level": 2,
                "value": "You will hear an archaeology student giving a presentation on an important site in Ireland called the Cagie Fields.",
                "meta": {
                  "to": 10.24,
                  "from": 2.08,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2800498,
                "level": 2,
                "value": "First, you have some time to look at questions 31 to 40.",
                "meta": {
                  "to": 15.2,
                  "from": 10.96,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2800508,
                "level": 2,
                "value": "Now listen carefully and answer questions 31 to 40.",
                "meta": {
                  "to": 85.189995,
                  "from": 80.31,
