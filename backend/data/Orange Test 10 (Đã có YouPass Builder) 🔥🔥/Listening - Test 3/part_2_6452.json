                }
              },
              {
                "id": 2759330,
                "level": 2,
                "value": "I had never seen one, and I hadn't been particularly interested in them at school.",
                "meta": {
                  "to": 208.64,
                  "from": 204.56,
                  "speaker": "Speaker 2"
                }
              },
              {
                "id": 2759346,
                "level": 2,
                "value": "Then I came across this story about a family of dolphins who had to leave their home in the Moray Firth because of the oil companies and about a child who campaigned to save them.",
                "meta": {
                  "to": 220.49501,
                  "from": 209.375,
                  "speaker": "Speaker 2"
                }
              }
            ]
          },
          {
            "id": 2759382,
            "level": 1,
            "value": "I couldn't put the book down. I was hooked.",
