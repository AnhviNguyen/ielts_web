                  "to": 22.945,
                  "from": 18.305,
                  "speaker": "Speaker 0"
                }
              },
              {
                "id": 2889105,
                "level": 2,
                "value": "Now listen carefully and answer questions 11 to 14.",
                "meta": {
                  "to": 47.875,
                  "from": 43.235,
