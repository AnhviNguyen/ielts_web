                  "from": 386.345,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2897770,
                "level": 2,
                "value": "In the eighteenth century, the scientist and politician Benjamin Franklin carried out work on electricity and lightning in particular.",
                "meta": {
                  "to": 411.50504,
