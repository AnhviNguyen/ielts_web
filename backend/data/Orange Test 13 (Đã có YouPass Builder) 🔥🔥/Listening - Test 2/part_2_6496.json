            ]
          },
          {
            "id": 2877461,
            "level": 1,
            "value": "Before you hear the rest of the talk, you have some time to look at questions 17 to 20. Now listen and answer questions 17 to 20.",
            "children": [
              {
                "id": 2877462,
                "level": 2,
                "value": "Before you hear the rest of the talk, you have some time to look at questions 17 to 20.",
                "meta": {
