                  "from": 278.25,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2882199,
                "level": 2,
                "value": "Jonathan Atwell in Indiana University is looking at how a range of animals respond to urban environments.",
                "meta": {
                  "to": 295.165,
