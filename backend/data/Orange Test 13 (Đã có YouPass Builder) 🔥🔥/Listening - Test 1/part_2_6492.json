                "meta": {
                  "to": 271.86502,
                  "from": 265.785,
                  "speaker": "Speaker 1"
                }
              },
              {
                "id": 2874914,
                "level": 2,
                "value": "That's a very busy area, so it should help things there.",
                "meta": {
